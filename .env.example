# ---------------------------------------------------------------------------
# Tarelli - variables de entorno de ejemplo. Copiar a .env y ajustar valores.
# NUNCA versionar el archivo .env real ni secretos reales.
# ---------------------------------------------------------------------------

# --- General ---
NODE_ENV=development

# --- PostgreSQL (desarrollo vía Docker) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tarelli
POSTGRES_USER=tarelli_app
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgres://tarelli_app:change_me_dev_only@postgres:5432/tarelli

# --- Backend ---
PORT=4000
# Access token JWT (corta duración, en memoria en el frontend)
JWT_ACCESS_SECRET=change_me_dev_only_access_secret_please_rotate
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (cookie HttpOnly/Secure, persistido como hash + rotación)
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret_please_rotate
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=tarelli_refresh
# CSRF (double-submit token)
CSRF_COOKIE_NAME=tarelli_csrf

# CORS - allowlist separado por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api
